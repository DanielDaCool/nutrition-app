<?xml version="1.0" encoding="utf-8"?>
<!-- Periwinkle (default) progress drawable: rounded track + rounded clipped
     fill. Solid fills only, per the mockup's RemoteViews-safe build notes. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/lockscreen_track"/>
            <corners android:radius="4dp"/>
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/lockscreen_accent_periwinkle"/>
                <corners android:radius="4dp"/>
            </shape>
        </clip>
    </item>
</layer-list>
