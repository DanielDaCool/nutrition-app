<?xml version="1.0" encoding="utf-8"?>
<!--
  Lock-screen notification, collapsed form: a single-line row Android shows
  when it collapses the notification among others — "8,612 / 10,000 ·
  1,450 kcal left", truncating with an ellipsis if space is tight.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/lockscreen_collapsed_background"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/lockscreen_app_icon_background"/>

    <TextView
        android:id="@+id/lockscreen_collapsed_line"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:textColor="@color/lockscreen_text_high"
        android:textSize="14sp"
        android:textStyle="bold"
        android:fontFeatureSettings="tnum"
        android:singleLine="true"
        android:ellipsize="end"
        tools:text="8,612 / 10,000 steps · 1,450 kcal left"/>
</LinearLayout>
